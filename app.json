{
  "expo": {
    "name": "SwasthBite Partner",
    "slug": "swasthbite-partner",
    "version": "1.0.1",
    "scheme": "swasthbite-partner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swasthbite.store",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "Allow SwasthBite Partner to take photos for menu catalog requests.",
        "NSPhotoLibraryUsageDescription": "Allow SwasthBite Partner to pick photos for menu catalog requests."
      }
    },
    "android": {
      "package": "com.swasthbite.store",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E23744",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1D4ED8"
        }
      ],
      "expo-image",
      [
        "expo-live-activity",
        {
          "enablePushNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SwasthBite Partner to access photos for menu item images.",
          "cameraPermission": "Allow SwasthBite Partner to use the camera for menu item photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e611e21-c6ac-4e42-83ff-bf4b17337b0a"
      }
    },
    "owner": "bhaskar0812",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e611e21-c6ac-4e42-83ff-bf4b17337b0a"
    }
  }
}
